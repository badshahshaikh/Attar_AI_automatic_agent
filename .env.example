# Copy this file to .env and fill in your values

# ── LLM Provider ─────────────────────────────────────────────────────────────
# "openai" (default) or "cloudflare". Use cloudflare when OpenAI has no
# balance — Cloudflare Workers AI is OpenAI-compatible and supports tool
# calling on models such as @cf/meta/llama-3.3-70b-instruct-fp8-fast.
LLM_PROVIDER=cloudflare

# ── OpenAI (used when LLM_PROVIDER=openai) ──────────────────────────────────
OPENAI_API_KEY=sk-...your-openai-key-here...
OPENAI_MODEL=gpt-4o-mini
# Seconds before an OpenAI request times out (default: 30)
OPENAI_TIMEOUT=30

# ── Cloudflare Workers AI (used when LLM_PROVIDER=cloudflare) ────────────────
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# A model that supports function/tool calling, e.g.:
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
# Seconds before a Cloudflare request times out (default: 60)
CLOUDFLARE_TIMEOUT=60

# ── API Hardening ────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins (default: localhost:8000)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Max POST /chat requests allowed per client IP per minute (default: 30)
RATE_LIMIT_PER_MINUTE=30
# Maximum characters allowed in a single chat message (default: 2000)
MAX_MESSAGE_LENGTH=2000

# ── Google Sheets Inventory ──────────────────────────────────────────────────
# The long ID from your Google Sheet URL:
# https://docs.google.com/spreadsheets/d/SHEET_ID_HERE/edit
GOOGLE_SHEET_ID=your-google-sheet-id-here

# The exact name of the worksheet tab (default: Products)
GOOGLE_SHEET_NAME=Products

# Seconds before a Google Sheets request times out (default: 30)
GOOGLE_HTTP_TIMEOUT=30

# Paste the FULL contents of your service-account JSON key file here.
# Keep this on ONE line — replace all newlines with \n inside the JSON string.
# Alternatively, set this to the PATH to the JSON file (e.g. ./service_account.json)
# NEVER commit this value to git.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}
